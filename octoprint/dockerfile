FROM octoprint/octoprint:latest

USER root

# Dependências necessárias para MJPG-Streamer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        cmake \
        pkg-config \
        libjpeg62-turbo-dev \
        libv4l-dev \
        v4l-utils \
        ffmpeg \
        imagemagick \
        htop && \
    rm -rf /var/lib/apt/lists/*

# Clonar MJPG-Streamer
RUN git clone https://github.com/jacksonliam/mjpg-streamer.git /opt/mjpg-streamer

# Compilar e instalar
RUN cd /opt/mjpg-streamer/mjpg-streamer-experimental && \
    make && \
    make install

EXPOSE 5000
EXPOSE 8080

USER octoprint
