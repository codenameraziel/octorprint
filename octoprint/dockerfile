FROM octoprint/octoprint:latest

USER root

# Dependências para MJPG-Streamer
RUN apt-get update && \
    apt-get install -y \
    git \
    build-essential \
    cmake \
    libjpeg-dev \
    imagemagick \
    ffmpeg \
    htop && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Clonar e compilar MJPG-Streamer
RUN git clone https://github.com/jacksonliam/mjpg-streamer.git /opt/mjpg-streamer && \
    cd /opt/mjpg-streamer/mjpg-streamer-experimental && \
    make && \
    make install

ENV ENABLE_MJPG_STREAMER=true
ENV MJPG_STREAMER_INPUT="-y -n -r 1920x1080 -f 30 -d /dev/video0"
ENV MJPG_STREAMER_OUTPUT="-o output_http.so -w /opt/mjpg-streamer/mjpg-streamer-experimental/www"
