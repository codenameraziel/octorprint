FROM octoprint/octoprint:latest

USER root

# Remove listas antigas e força a aceitação da mudança de repositórios antigos do Debian
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get update --allow-releaseinfo-change && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git \
        build-essential \
        cmake \
        pkg-config \
        libjpeg-dev \
        libv4l-dev \
        v4l-utils \
        ffmpeg \
        imagemagick \
        htop && \
    rm -rf /var/lib/apt/lists/*

# Clonar MJPG-Streamer
RUN git clone https://github.com /opt/mjpg-streamer

# Compilar e instalar
RUN cd /opt/mjpg-streamer/mjpg-streamer-experimental && \
    make && \
    make install

EXPOSE 5000
EXPOSE 8080

USER octoprint

